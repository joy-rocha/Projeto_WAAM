/* Requisição pronta, direto da documentação:
 * 01 03 00 0E 00 01 E5 C9
 * (CRC enviado com o byte BAIXO primeiro: E5, depois C9) */
static const uint8_t req_corrente[REQ_LEN] =
    { 0x01, 0x03, 0x00, 0x0E, 0x00, 0x01, 0xE5, 0xC9 };

/* ---------- CRC-16 Modbus (polinômio 0xA001) ---------- */
static uint16_t modbus_crc16(const uint8_t *data, uint16_t len)
{
    uint16_t crc = 0xFFFF;
    for (uint16_t i = 0; i < len; i++) {
        crc ^= data[i];
        for (uint8_t b = 0; b < 8; b++) {
            crc = (crc & 1) ? (crc >> 1) ^ 0xA001 : crc >> 1;
        }
    }
    return crc;
}

/* ---------- Leitura do sensor ----------
 * Retorna HAL_OK e preenche *valor_bruto (registrador 0x000E) em caso de sucesso.
 * A conversão para Ampères depende do fator de escala descrito no manual. */
HAL_StatusTypeDef sensor_corrente_ler(uint16_t *valor_bruto)
{
    uint8_t resp[RESP_LEN] = {0};
    HAL_StatusTypeDef st;

    /* Descarta lixo que esteja no registrador de recepção */
    __HAL_UART_FLUSH_DRREGISTER(&huart2);

    /* 1) Envia a requisição */
    st = HAL_UART_Transmit(&huart2, (uint8_t *)req_corrente, REQ_LEN, 100);
    if (st != HAL_OK) return st;

    /* 2) Recebe a resposta de 7 bytes */
    st = HAL_UART_Receive(&huart2, resp, RESP_LEN, RESP_TIMEOUT_MS);
    if (st != HAL_OK) return st;

    /* 3) Valida endereço, função e quantidade de bytes */
    if (resp[0] != SENSOR_ADDR || resp[1] != 0x03 || resp[2] != 0x02)
        return HAL_ERROR;

    /* 4) Valida CRC (na resposta vem: byte baixo, depois byte alto) */
    uint16_t crc_calc = modbus_crc16(resp, 5);
    uint16_t crc_recv = (uint16_t)resp[5] | ((uint16_t)resp[6] << 8);
    if (crc_calc != crc_recv)
        return HAL_ERROR;

    /* 5) Valor medido: byte alto + byte baixo (ex.: 05 DC -> 0x05DC = 1500) */
    *valor_bruto = ((uint16_t)resp[3] << 8) | resp[4];
    return HAL_OK;
}
int _write(int file, char *ptr, int len)
{
    HAL_UART_Transmit(&huart1, (uint8_t *)ptr, len, HAL_MAX_DELAY);
    return len;
}

